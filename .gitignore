# Arduino build artifacts
*.bin
*.elf
*.hex
build/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env

# MATLAB
*.asv
*.m~
slprj/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/

# Model weights (too large for Git)
*.pt
*.bin
best_ncnn_model/

# Logs
*.log

# Vision training: never commit image data
vision_training/**/*.jpg
vision_training/**/*.jpeg
vision_training/**/*.png

# Vision results: allow plots, block model exports and caches
!vision_training/results/**/*.png
!vision_training/results/**/*.jpg
*_ncnn_model/
*.cache
